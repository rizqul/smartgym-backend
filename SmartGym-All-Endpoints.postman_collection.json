{
  "info": {
    "_postman_id": "4a79781c-7219-4c7f-a6e9-1c9a4ac6f843",
    "name": "SmartGym - All Endpoints",
    "description": "Complete SmartGym API collection. Select the existing SmartGym environment to use {{apiUrl}}. Login requests use role-specific email/password variables; authenticated requests use the cookies returned by login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{apiUrl}}/auth/login"
          },
          "response": []
        },
        {
          "name": "Staff",
          "item": [
            {
              "name": "List Staff",
              "request": {"method": "GET", "url": "{{apiUrl}}/admin/dashboard/staff?page=1&size=50&name="},
              "response": []
            },
            {
              "name": "Create Staff",
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {"mode": "raw", "raw": "{\n  \"name\": \"{{staffName}}\",\n  \"email\": \"{{staffEmail}}\",\n  \"phoneNumber\": \"081234567890\",\n  \"password\": \"{{staffPassword}}\"\n}", "options": {"raw": {"language": "json"}}},
                "url": "{{apiUrl}}/admin/dashboard/staff/create"
              },
              "response": []
            },
            {
              "name": "Update Staff",
              "request": {
                "method": "PUT",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {"mode": "raw", "raw": "{\n  \"name\": \"Updated Staff\",\n  \"email\": \"{{staffEmail}}\",\n  \"phoneNumber\": \"081234567890\"\n}", "options": {"raw": {"language": "json"}}},
                "url": "{{apiUrl}}/admin/dashboard/staff/update/{{staffId}}"
              },
              "response": []
            },
            {
              "name": "Delete Staff",
              "request": {"method": "DELETE", "url": "{{apiUrl}}/admin/dashboard/staff/delete/{{staffId}}"},
              "response": []
            }
          ]
        },
        {
          "name": "Members",
          "item": [
            {
              "name": "List Members",
              "request": {"method": "GET", "url": "{{apiUrl}}/admin/dashboard/members?page=1&size=50&name="},
              "response": []
            },
            {
              "name": "Request Member OTP",
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{memberEmail}}\"\n}", "options": {"raw": {"language": "json"}}},
                "url": "{{apiUrl}}/admin/dashboard/members/otp"
              },
              "response": []
            },
            {
              "name": "Create Member",
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {"mode": "raw", "raw": "{\n  \"name\": \"{{memberName}}\",\n  \"email\": \"{{memberEmail}}\",\n  \"code\": \"{{memberCreateOtp}}\",\n  \"phoneNumber\": \"081234567890\",\n  \"password\": \"{{memberPassword}}\"\n}", "options": {"raw": {"language": "json"}}},
                "url": "{{apiUrl}}/admin/dashboard/members/create"
              },
              "response": []
            },
            {
              "name": "Delete Member",
              "request": {"method": "DELETE", "url": "{{apiUrl}}/admin/dashboard/members/delete/{{memberId}}"},
              "response": []
            }
          ]
        },
        {
          "name": "Membership Packages",
          "item": [
            {
              "name": "List Membership Packages",
              "request": {"method": "GET", "url": "{{apiUrl}}/admin/dashboard/memberships/packages"},
              "response": []
            },
            {
              "name": "Create Membership Package",
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {"mode": "raw", "raw": "{\n  \"type\": \"MONTHLY\",\n  \"name\": \"Monthly Membership\",\n  \"description\": \"30-day gym membership\",\n  \"duration\": 30,\n  \"price\": 300000\n}", "options": {"raw": {"language": "json"}}},
                "url": "{{apiUrl}}/admin/dashboard/memberships/packages/create"
              },
              "response": []
            },
            {
              "name": "Update Membership Package",
              "request": {
                "method": "PATCH",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {"mode": "raw", "raw": "{\n  \"type\": \"MONTHLY\",\n  \"name\": \"Updated Monthly Membership\",\n  \"description\": \"Updated package description\",\n  \"duration\": 30\n}", "options": {"raw": {"language": "json"}}},
                "url": "{{apiUrl}}/admin/dashboard/memberships/packages/update/{{membershipPackageId}}"
              },
              "response": []
            },
            {
              "name": "Delete Membership Package",
              "request": {"method": "DELETE", "url": "{{apiUrl}}/admin/dashboard/memberships/packages/delete/{{membershipPackageId}}"},
              "response": []
            }
          ]
        },
        {
          "name": "Trainers",
          "item": [
            {
              "name": "List Trainers",
              "request": {"method": "GET", "url": "{{apiUrl}}/admin/dashboard/trainers?page=1&size=50&name="},
              "response": []
            },
            {
              "name": "Create Trainer",
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {"mode": "raw", "raw": "{\n  \"name\": \"Trainer Name\",\n  \"email\": \"trainer@example.com\",\n  \"phoneNumber\": \"081234567890\",\n  \"specialization\": \"GENERAL_FITNESS\",\n  \"experience\": \"3\",\n  \"rate\": \"150000\"\n}", "options": {"raw": {"language": "json"}}},
                "url": "{{apiUrl}}/admin/dashboard/trainers/create"
              },
              "response": []
            },
            {
              "name": "List Trainer Slots",
              "request": {"method": "GET", "url": "{{apiUrl}}/admin/dashboard/trainers/slot/{{trainerId}}?date={{slotDate}}"},
              "response": []
            },
            {
              "name": "Create Trainer Slot",
              "request": {
                "method": "POST",
                "header": [{"key": "Content-Type", "value": "application/json"}],
                "body": {"mode": "raw", "raw": "{\n  \"description\": \"Personal training session\",\n  \"slotDate\": \"{{slotDate}}\",\n  \"startTime\": \"{{slotStartTime}}\",\n  \"endTime\": \"{{slotEndTime}}\"\n}", "options": {"raw": {"language": "json"}}},
                "url": "{{apiUrl}}/admin/dashboard/trainers/slot/create/{{trainerId}}"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Check-ins",
          "item": [
            {
              "name": "Generate QR Token",
              "request": {
                "method": "POST",
                "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["const response = pm.response.json();\npm.environment.set(\"checkinQrToken\", response.data.token);"]}}],
                "url": "{{apiUrl}}/admin/dashboard/checkins/qr-token"
              },
              "response": []
            },
            {
              "name": "List Recent Check-ins",
              "request": {"method": "GET", "url": "{{apiUrl}}/admin/dashboard/checkins?limit=10"},
              "response": []
            },
            {
              "name": "Check-in Summary",
              "request": {"method": "GET", "url": "{{apiUrl}}/admin/dashboard/checkins/summary"},
              "response": []
            },
            {
              "name": "Check Out Member",
              "request": {
                "method": "POST",
                "description": "Admin closes the active check-in for the member ID in {{memberId}}.",
                "header": [{"key": "Accept", "value": "application/json"}],
                "url": "{{apiUrl}}/admin/dashboard/checkins/{{memberId}}/checkout"
              },
              "response": []
            }
          ]
        },
        {
          "name": "Transactions",
          "item": [
            {
              "name": "List All Transactions",
              "request": {"method": "GET", "url": "{{apiUrl}}/admin/dashboard/transactions?page=1&size=50"},
              "response": []
            }
          ],
          "variable": [
            {"key": "staffName", "value": "", "type": "string", "description": "Set before creating a staff account."},
            {"key": "trainerId", "value": "", "type": "string", "description": "Trainer ID used by trainer slot requests."},
            {"key": "slotDate", "value": "", "type": "string", "description": "Future date in YYYY-MM-DD format."},
            {"key": "slotStartTime", "value": "", "type": "string", "description": "Future local date-time in YYYY-MM-DDTHH:mm format."},
            {"key": "slotEndTime", "value": "", "type": "string", "description": "Future local date-time in YYYY-MM-DDTHH:mm format."},
            {"key": "trainerSlotId", "value": "", "type": "string", "description": "Trainer slot ID used when booking a trainer."},
            {"key": "memberNewPassword", "value": "", "type": "string", "description": "New password used by password update/reset requests."},
            {"key": "transactionId", "value": "", "type": "string", "description": "Transaction/order ID used by transaction and payment requests."},
            {"key": "midtransSignatureKey", "value": "", "type": "string", "description": "Valid Midtrans webhook signature for notification testing."}
          ]
        }
      ]
    },
