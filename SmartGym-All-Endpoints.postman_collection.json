        {
          "name": "Profile",
          "item": [
            {
              "name": "Get My Profile",
              "request": {"method": "GET", "url": "{{apiUrl}}/user"},
              "response": []
            },
            {
              "name": "Update My Profile",
              "request": {
                "method": "PUT",
                "body": {"mode": "formdata", "formdata": [
                  {"key": "name", "value": "{{memberName}}", "type": "text"},
                  {"key": "phoneNumber", "value": "081234567890", "type": "text"},
                  {"key": "photo", "type": "file", "src": ""}
