    {
      "name": "Member",
      "item": [
        {
          "name": "Login Member",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{apiUrl}}/auth/login"
          },
          "response": []
