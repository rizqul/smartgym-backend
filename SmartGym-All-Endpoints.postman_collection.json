    {
      "name": "Umum",
      "item": [
        {
          "name": "Request Password Reset OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"{{memberEmail}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{apiUrl}}/auth/forgot-password"
          },
          "response": []
        },
        {
          "name": "Verify Password Reset OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"code\": \"{{memberResetOtp}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{apiUrl}}/auth/reset-verify"
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"password\": \"{{memberNewPassword}}\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{apiUrl}}/auth/reset-password"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {"method": "POST", "url": "{{apiUrl}}/auth/refresh"},
          "response": []
        },
        {
          "name": "Logout",
          "request": {"method": "POST", "url": "{{apiUrl}}/auth/logout"},
          "response": []
        },
        {
          "name": "Midtrans Payment Notification (Webhook)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"signature_key\": \"{{midtransSignatureKey}}\",\n  \"status_code\": \"200\",\n  \"order_id\": \"{{transactionId}}\",\n  \"gross_amount\": \"300000.00\"\n}", "options": {"raw": {"language": "json"}}},
            "url": "{{apiUrl}}/midtrans/notification"
          },
          "response": []
        },
        {
          "name": "Validate Membership Payment",
          "request": {"method": "GET", "url": "{{apiUrl}}/midtrans/membership?order_id={{transactionId}}"},
          "response": []
        },
        {
          "name": "Validate Trainer Booking Payment",
          "request": {"method": "GET", "url": "{{apiUrl}}/midtrans/pt-booking?order_id={{transactionId}}"},
          "response": []
        }
