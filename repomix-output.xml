        try {
            transactionService.cancelTransaction(orderId);

            String message = "Berhasil Membatalkan Transaksi!";
            return ApiResponse.success(HttpStatus.OK, message);
        } catch (Exception e) {
            throw new BadRequestException(e.getMessage());
        }
    }
