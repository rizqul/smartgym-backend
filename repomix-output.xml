package com.gymmick.smartgym.validation;

import org.springframework.web.multipart.MultipartFile;

import com.gymmick.smartgym.validation.annotation.FileSize;

import jakarta.validation.*;

public class FileSizeValidation implements ConstraintValidator<FileSize, Object> {

    private boolean required;
    private double maxSize;

    @Override
    public void initialize(FileSize constraintAnnotation) {
        this.required = constraintAnnotation.required();
        this.maxSize = constraintAnnotation.max();
    }

    @Override
    public boolean isValid(Object file, ConstraintValidatorContext context) {
        if (!this.required && file == null) {
            return true;
        }

        if (file == null || file.getClass().equals(String.class)) {
            return false;
        }

        if (!(file instanceof MultipartFile uploadedFile) || uploadedFile.isEmpty()) {
            return false;
        }

        return uploadedFile.getSize() <= maxSize * 1024 * 1024;
    }
}
</file>

<file path="src/main/java/com/gymmick/smartgym/validation/FileValidation.java">
package com.gymmick.smartgym.validation;

import java.io.InputStream;
import java.util.Arrays;

import org.apache.tika.Tika;
import org.springframework.web.multipart.MultipartFile;

import com.gymmick.smartgym.validation.annotation.File;

import jakarta.validation.*;

public class FileValidation implements ConstraintValidator<File, Object> {

    private static final Tika tika = new Tika();

    private Boolean required;
    private String[] contentType;

    @Override
    public void initialize(File annotation) {
        this.required = annotation.required();
        this.contentType = annotation.contentType();
    }

    @Override
    public boolean isValid(Object file, ConstraintValidatorContext context) {

        if (!this.required && file == null) {
            return true;
        }

        if (file == null || file.getClass().equals(String.class)) {
            return false;
        }

        if (!(file instanceof MultipartFile uploadedFile) || uploadedFile.isEmpty()) {
            return false;
        }

        String mimeType;

        try (InputStream inputStream = uploadedFile.getInputStream()) {
            mimeType = tika.detect(inputStream);
        } catch (Exception e) {
            return false;
        }

        return Arrays.stream(contentType)
                .anyMatch(type -> type.equals("*/*") || type.equalsIgnoreCase(mimeType));
    }
}
</file>

<file path="src/main/java/com/gymmick/smartgym/validation/IdPhoneNumberValidation.java">
package com.gymmick.smartgym.validation;

import com.gymmick.smartgym.validation.annotation.IdPhoneNumber;

import jakarta.validation.*;

public class IdPhoneNumberValidation implements ConstraintValidator<IdPhoneNumber, String> {

  @Override
  public boolean isValid(String value, ConstraintValidatorContext context) {
    if (value == null || value.isBlank()) {
      return true;
    }

    return value.matches("^(62|0)8([0-9]){8,11}$");
  }
}
